{
  "name": "scanlight-pi-app",
  "version": "0.1.0",
  "private": true,
  "description": "Hosted web controller for Scanlight film-scanning light: Node server talks USB serial to the Scanlight Pico and triggers the camera via gphoto2; Vue 3 + Vuetify UI over Socket.io.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"node server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "lint": "eslint . --ext .vue,.js,.cjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "serialport": "^12.0.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.1.1",
    "@mdi/font": "^7.4.47",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.32.0",
    "socket.io-client": "^4.8.1",
    "vite": "^5.4.11",
    "vite-plugin-vuetify": "^2.0.4",
    "vue": "^3.5.13",
    "vuetify": "^3.7.6"
  }
}
